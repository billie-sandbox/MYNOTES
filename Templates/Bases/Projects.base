filters:
  and:
    - '!file.name.contains("Template")'
    - note.categories.contains(link("Projects"))
properties:
  note.status:
    displayName: Status
  note.url:
    displayName: URL
  file.name:
    displayName: Name
  note.type:
    displayName: Type
  note.year:
    displayName: Year
  note.created:
    displayName: Created
views:
  - type: table
    name: Table
    order:
      - file.name
      - type
      - year
      - status
      - url
    sort:
      - column: note.status
        direction: ASC
      - column: note.year
        direction: DESC
    columnSize:
      file.name: 209
      note.type: 199
  - type: table
    name: Active
    filters:
      and:
        - status.contains("active")
    order:
      - file.name
      - type
      - start
      - url
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Ideas
    filters:
      and:
        - status.contains("idea")
    order:
      - file.name
      - type
      - created
    sort:
      - property: created
        direction: DESC
  - type: table
    name: Paused or done
    filters:
      or:
        - status.contains("paused")
        - status.contains("done")
    order:
      - file.name
      - status
      - year
    sort:
      - property: file.mtime
        direction: DESC
